{
  "meta": {
    "title": "Sight Word and Spelling Lists, Kindergarten through Grade 8",
    "audience": "General elementary and middle school, aligned to the skill progression in the New Jersey Student Learning Standards for English Language Arts",
    "note": "New Jersey does not publish an official statewide sight word or spelling list. The NJSLS-ELA define skills, not word inventories, and the specific words are left to districts. This file is a general-purpose bank, not any single district's curriculum.",
    "provenance": {
      "K-3": "Dolch word lists (E.W. Dolch, 1936): 220 service words plus 95 nouns, reproduced verbatim. Public domain.",
      "4-8": "Curated lists organized around the skills the standards call for at each grade: morphology, homophones, and academic vocabulary. These are representative general lists, not a transcription of any published or copyrighted spelling program."
    },
    "usage": "Each grade holds one or more named sets. Words are lowercase except proper nouns."
  },

